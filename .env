SERVICE_NAME=worker-management

# GCP Secret Manager secret ids (values fetched at runtime via get_secret)
PG_DB_URL_NAME=pg-db-url
EXPO_ACCESS_TOKEN_KEY_NAME=expo-access-token
AGENT_MANAGEMENT_BASE_URL_NAME=agent-management-base-url
AGENT_MANAGEMENT_SERVICE_TOKEN_NAME=agent-management-service-token

# Static
EXPO_PUSH_PUBSUB_TOPIC_NAME=expo-push-notifications
EXPO_PUSH_PUBSUB_SUBSCRIPTION=expo-push-notifications-sub
POLL_INTERVAL_SECONDS=60
BATCH_SIZE=50
RECLAIM_AFTER_SECONDS=900
MAX_CONCURRENT_NOTIFICATIONS=5
PUBSUB_MAX_MESSAGES=5
PUBSUB_MAX_DELIVERY_ATTEMPTS=5
PUBSUB_ACK_EXTENSION_SECONDS=600
SUMMARY_LOG_INTERVAL_SECONDS=300
