ENV=dev
PORT=8080
PROJECT_ID=

# Plaintext secrets for local development
PG_DB_URL=
EXPO_ACCESS_TOKEN_KEY=

NOTIFICATION_PUBSUB_TOPIC_NAME=notification-pubsub
EXPO_PUSH_PUBSUB_TOPIC_NAME=expo-push-notifications
EXPO_PUSH_PUBSUB_SUBSCRIPTION=expo-push-notifications-sub

POLL_INTERVAL_SECONDS=60
BATCH_SIZE=50
RECLAIM_AFTER_SECONDS=900
MAX_CONCURRENT_NOTIFICATIONS=5
PUBSUB_MAX_MESSAGES=5
PUBSUB_MAX_DELIVERY_ATTEMPTS=5
PUBSUB_ACK_EXTENSION_SECONDS=600
SUMMARY_LOG_INTERVAL_SECONDS=300

# Agent-management push API (local)
AGENT_MANAGEMENT_BASE_URL=http://localhost:8000/v1
# Generate token: cd ../ai-agent-management && poetry run python scripts/generate_service_token.py worker-management
AGENT_MANAGEMENT_SERVICE_TOKEN=
